# Supabase — Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Write access. Bypasses row level security, so it belongs only in the
# collector's secrets — never in Vercel's build or runtime env.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Salt for hashing caller addresses for rate limiting. Any long random
# string; changing it resets everyone's allowance, which is harmless.
RATE_LIMIT_SALT=change-me

# debug | info | warn | error
LOG_LEVEL=info
